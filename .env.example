# Copia a .env en local. En Render: cárgalas en Environment (NUNCA subas el .env real).

# Render define PORT automáticamente; este valor solo aplica en local.
PORT=3000
# URL pública de la app (https://<tu-servicio>.onrender.com en Render, http://localhost:3000 en local)
CORS_ORIGIN=

# Genera cada uno con: npm run gen:secret   (o: openssl rand -hex 32)
JWT_SECRET=
KEK_HEX=

# Límites de seguridad de pago (sats)
MAX_PAY_SATS=50000
DAILY_CAP_SATS=200000

# Proveedores LLM compatibles con la API de OpenAI (configura al menos uno)
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
