# Copiar a /etc/caddy/Caddyfile  (cambia el dominio)
teranga.tudominio.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /opt/teranga-pay/public
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss://relay.damus.io wss://nos.lol; frame-ancestors 'none'"
		-Server
	}
}
